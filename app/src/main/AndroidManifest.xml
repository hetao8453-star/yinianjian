<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules_26_10_25"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.一念间">

        <activity
            android:name=".IntroActivity_26_10_26"
            android:exported="true"
            android:theme="@style/Theme.一念间">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".SummaryActivity_26_10_26"
            android:exported="false" />

        <activity
            android:name=".AppPickerActivity_26_10_25"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".EncourageSettingsActivity_26_10_27"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".PermissionGuideActivity_26_10_25"
            android:exported="false" />

        <activity
            android:name=".AppRecordActivity_26_10_25"
            android:exported="false" />

        <service
            android:name=".IntentAccessibilityService_26_10_25"
            android:exported="true"
            android:label="一念间 · 应用使用提示"
            android:stopWithTask="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/intent_accessibility_26_10_25" />
        </service>

        <service
            android:name=".KeepAliveService_26_10_26"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="保持意图提醒服务运行" />
        </service>

        <receiver
            android:name=".DailySummaryReceiver_26_10_26"
            android:exported="false" />

        <receiver
            android:name=".BootReceiver_26_10_25"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
